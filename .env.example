# ==============================================================================
# Alotta Cake Commerce Ops & Edge Reconciliation Agent — Environment Template
# ==============================================================================
# Copy to `commerce_ops_agent/.env` for local runs. NEVER commit real secrets.
# In production (Cloud Run / Vertex Agent Engine), secrets are injected dynamically
# via Google Cloud Secret Manager (`GCP_PROJECT_ID`).

# 1. Gemini / Vertex AI Model Configuration
# Option A: Google AI Studio API Key (local development)
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=replace-with-gemini-api-key

# Option B: Google Cloud Vertex AI (production / Cloud Run)
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# 2. Google Cloud Project (for Secret Manager, Cloud DLP PII scrubbing & Cloud Trace)
GCP_PROJECT_ID=your-gcp-project-id
ENABLE_SECRET_MANAGER=false
ENABLE_CLOUD_DLP=false

# 3. Adapter Mode (`fixture` for deterministic offline CI/evals; `live` for real APIs)
COMMERCE_MODE=fixture

# 4. Shopify Configuration (Inject real values via Secret Manager or local env)
SHOPIFY_SHOP_DOMAIN=example-store.myshopify.com
SHOPIFY_API_VERSION=2026-07
SHOPIFY_CHECKOUT_HOSTNAME=checkout.alottacake.com
SHOPIFY_CLIENT_ID=replace-with-shopify-client-id
SHOPIFY_CLIENT_SECRET=replace-with-shopify-client-secret
# SHOPIFY_ADMIN_ACCESS_TOKEN=replace-with-optional-static-admin-token

# 5. Cloudflare Configuration (`alottacake.com` Edge Storefront)
CLOUDFLARE_STOREFRONT_BASE_URL=https://alottacake.com
CLOUDFLARE_ZONE_ID=00000000000000000000000000000000
CLOUDFLARE_API_TOKEN=replace-with-scoped-cloudflare-token

# 6. PII Pseudonymization & Operating Guardrails
COMMERCE_HMAC_SALT=public-safe-dev-hmac-salt-override-in-secret-manager
MIN_CONTRIBUTION_MARGIN_BPS=3500
FULFILLMENT_DRAFT_SLA_HOURS=24
MAX_RECOVERY_DISCOUNT_PERCENT=20
SESSION_DB_URL=sqlite+aiosqlite:///./.adk_sessions.db
